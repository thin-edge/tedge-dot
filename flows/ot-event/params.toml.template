# Per-signal events need no settings here: declare them on the connector point, next to the
# signal's address. They work for numbers, booleans and strings alike, e.g. on every change:
#   [[device.point]]
#   id   = "version"
#   meta = { event = { type = "firmware_changed", text = "Firmware changed to {value}" } }
# or each time a condition starts to hold:
#   meta = { event = { type = "pump_stopped", when = { equals = "STOPPED" } } }
# main.js documents every key (type, text, when).
#
#
# The measurement event (ONE series, an event each time its value changes) is the separate flow
# ot-event-series, with these settings in its own params file.
