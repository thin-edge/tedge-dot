# Per-signal alarms need no settings here: declare them on the connector point, next to the
# signal's address. They work for numbers, booleans and strings alike, e.g.
#   [[device.point]]
#   id   = "pump_state"
#   meta = { alarm = { type = "pump_fault", severity = "critical", when = { equals = "FAULT" } } }
# or, for a number, with hysteresis:
#   meta = { alarm = { type = "overheat", when = { above = 70, hysteresis = 5 } } }
# main.js documents every key (type, severity, text, when: equals / not_equals / above / below /
# hysteresis).
#
#
# The measurement alarm (ONE series watched with a threshold and hysteresis) is the separate flow
# ot-alarm-series, with these settings in its own params file.
