{
  "$schema": "./node_modules/@angular/cli/lib/config/schema.json",
  "version": 1,
  "newProjectRoot": "projects",
  "projects": {
    "tedge-dot-ui": {
      "projectType": "application",
      "root": "",
      "sourceRoot": "src",
      "architect": {
        "build": {
          "builder": "@c8y/devkit:build",
          "options": {
            "outputPath": "dist/tedge-dot-ui",
            "main": "src/main.ts",
            "tsConfig": "tsconfig.json",
            "polyfills": ["zone.js"],
            "assets": [{ "glob": "CHANGELOG.md", "input": "src/generated", "output": "/" }],
            "styles": ["src/styles.scss"]
          },
          "configurations": {
            "production": {
              "optimization": true,
              "outputHashing": "all"
            }
          }
        },
        "serve": {
          "builder": "@c8y/devkit:dev-server",
          "options": {
            "buildTarget": "tedge-dot-ui:build",
            "shell": "devicemanagement",
            "host": "0.0.0.0"
          },
          "configurations": {
            "production": {
              "buildTarget": "tedge-dot-ui:build:production"
            }
          }
        },
        "deploy": {
          "builder": "@c8y/devkit:deploy",
          "options": {}
        }
      }
    }
  },
  "cli": {
    "analytics": false
  }
}
