      "pushed": true,
      "steps": [
        { "at": 0, "sample": { "id": "a", "num": 0 }, "publish": ["a"] },
        { "at": 1000, "sample": { "id": "b", "num": 1 } },
        { "at": 2000, "tick": true },
        { "at": 9999, "tick": true },
        { "at": 10000, "tick": true, "publish": ["b"] }
      ]
    },
    {
      "name": "a value back at the published one drops a debounced reading held by the rate limit",
