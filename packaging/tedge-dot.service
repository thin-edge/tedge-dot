[Unit]
Description=thin-edge.io OT connectors (all protocols, one process)
Documentation=https://github.com/thin-edge/tedge-dot
After=network-online.target mosquitto.service
Wants=network-online.target

[Service]
Type=simple
User=tedge
Group=tedge
# The canbus/canopen connectors open SocketCAN raw sockets, which needs
# CAP_NET_RAW. The CAN interface itself must already exist and be up (brought
# up by your network setup, or by the demo simulators — see demo/README.md).
# The snmp connector receives traps on udp/162, a privileged port, which needs
# CAP_NET_BIND_SERVICE (it binds nothing until a device is configured).
AmbientCapabilities=CAP_NET_RAW CAP_NET_BIND_SERVICE
# One process runs every connector config found in the directory, each in an
# in-process restart loop (backoff via TEDGE_DOT_RESTART_DELAY, default 5s).
ExecStart=/usr/bin/tedge-dot run /etc/tedge/plugins/ot
# Edited, added and removed configs are applied without a restart: the service notices the
# change within a few seconds, and `systemctl reload tedge-dot` (SIGHUP) applies it at once. A
# connector whose file is unchanged keeps running untouched. The check runs every
# TEDGE_DOT_CONFIG_WATCH_INTERVAL (default 2s). To reload only on SIGHUP, add --no-watch in a
# drop-in (systemctl edit tedge-dot):
#   [Service]
#   ExecStart=
#   ExecStart=/usr/bin/tedge-dot run /etc/tedge/plugins/ot --no-watch
ExecReload=/bin/kill -HUP $MAINPID
Restart=always
RestartSec=5
TimeoutStopSec=15

[Install]
WantedBy=multi-user.target
