---
// The supported protocols, with what each one does and which package carries it. Protocols in
// preview (src/data/packages.yaml `preview_protocols`) come last, with a Preview chip.
import { readFileSync } from 'node:fs';
import YAML from 'yaml';

const { preview_protocols: preview } = YAML.parse(readFileSync('src/data/packages.yaml', 'utf8'));
const protocols: { id: string; name: string; transport: string; what: string; href: string; rs: boolean | 'source'; c: boolean }[] = [
  { id: 'modbus', name: 'Modbus', transport: 'TCP and RTU', what: 'Holding/input registers, coils, bit fields, every word order.', href: '/tedge-dot/reference/connectors/modbus/', rs: true, c: true },
  { id: 'opcua', name: 'OPC UA', transport: 'opc.tcp', what: 'Monitored items, secured sessions, X.509 users, method calls.', href: '/tedge-dot/reference/connectors/opcua/', rs: true, c: true },
  { id: 'snmp', name: 'SNMP', transport: 'UDP, v1/v2c/v3', what: 'GET, GETBULK and SET, plus traps and informs.', href: '/tedge-dot/reference/connectors/snmp/', rs: true, c: true },
  { id: 'canbus', name: 'CAN bus', transport: 'SocketCAN + DBC', what: 'Signals decoded from a DBC file; writes by read-modify-write.', href: '/tedge-dot/reference/connectors/canbus/', rs: true, c: true },
  { id: 'canopen', name: 'CANopen', transport: 'SocketCAN (SDO)', what: 'Object dictionary entries by index and sub-index.', href: '/tedge-dot/guides/canbus-canopen/', rs: true, c: true },
  { id: 'profibus', name: 'PROFIBUS-DP', transport: 'serial / tcp://', what: 'A DP-V0 class-1 master for cyclic I/O.', href: '/tedge-dot/guides/small-gateways/', rs: 'source', c: true },
];
---

<ul class="td-protocols not-content">
  {
    protocols.map((p) => (
      <li>
        <a href={p.href}>
          <span class="name">
            {p.name}
            {preview.includes(p.id) && (
              <span class="preview" title="Tested against simulators, not yet on real equipment">
                Preview
              </span>
            )}
          </span>
          <span class="transport">{p.transport}</span>
          <span class="what">{p.what}</span>
          <span class="pkgs">
            <span class:list={['pkg', { off: p.rs !== true }]} title={p.rs === true ? 'In tedge-dot-rs' : 'tedge-dot-rs: build from source'}>
              rs{p.rs === 'source' ? ' (source)' : ''}
            </span>
            <span class="pkg">c</span>
          </span>
        </a>
      </li>
    ))
  }
</ul>

<style>
  .td-protocols {
    list-style: none;
    padding: 0;
    display: grid;
    gap: 1rem;
    grid-template-columns: repeat(auto-fill, minmax(min(100%, 15rem), 1fr));
  }
  .td-protocols li {
    margin: 0;
  }
  a {
    display: grid;
    /* Name, transport and text at the top; the package chips at the bottom of every card. */
    grid-template-rows: auto auto 1fr auto;
    align-content: start;
    gap: 0.35rem;
    height: 100%;
    box-sizing: border-box;
    padding: 1.1rem 1.2rem;
    border-radius: var(--td-radius);
    border: 1px solid var(--td-border);
    background: var(--td-surface);
    text-decoration: none;
    color: inherit;
    transition: border-color 0.15s, transform 0.15s;
  }
  a:hover {
    border-color: var(--sl-color-accent);
    transform: translateY(-2px);
  }
  .name {
    font-size: var(--sl-text-lg);
    font-weight: 700;
    color: var(--sl-color-white);
  }
  .name {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 0.25rem 0.5rem;
  }
  .preview {
    font-size: 0.68rem;
    font-weight: 700;
    letter-spacing: 0.04em;
    text-transform: uppercase;
    line-height: 1;
    padding: 0.2rem 0.5rem;
    border-radius: 999px;
    border: 1px solid color-mix(in srgb, var(--td-warn) 60%, transparent);
    color: var(--td-warn);
  }
  .transport {
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    color: var(--sl-color-accent);
  }
  .what {
    font-size: var(--sl-text-sm);
    color: var(--sl-color-gray-2);
  }
  .pkgs {
    display: flex;
    align-self: end;
    gap: 0.35rem;
    margin-top: 0.25rem;
  }
  .pkg {
    display: inline-flex;
    align-items: center;
    height: 1.4rem;
    line-height: 1;
    font-family: var(--sl-font-mono);
    font-size: var(--sl-text-xs);
    padding: 0 0.45rem;
    border-radius: 999px;
    border: 1px solid var(--td-border);
    color: var(--sl-color-gray-2);
  }
  .pkg.off {
    border-style: dashed;
    color: var(--td-muted);
  }
</style>
