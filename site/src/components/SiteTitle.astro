---
// Replaces Starlight's SiteTitle: the mark is inline SVG rather than an <img>, so it is part of
// every page's HTML and does not blink while the browser fetches and decodes it on each
// navigation. The same drawing is src/assets/mark.svg (the favicon is public/favicon.svg).
const { siteTitle, siteTitleHref } = Astro.locals.starlightRoute;
---

<a href={siteTitleHref} class="site-title sl-flex">
  <svg class="mark" viewBox="0 0 32 32" aria-hidden="true" focusable="false">
    <rect width="32" height="32" rx="8" fill="#181564" stroke="#ffffff" stroke-opacity="0.18"></rect>
    <path d="M5 9h6.5l4.5 7M5 16h11M5 23h6.5l4.5-7" stroke="#a9a7e6" stroke-width="2" fill="none" stroke-linecap="round" stroke-linejoin="round"></path>
    <path d="M17 16h10" stroke="#ffe400" stroke-width="2" stroke-linecap="round"></path>
    <circle cx="17" cy="16" r="4.5" fill="#ffe400"></circle>
  </svg>
  <span translate="no">{siteTitle}</span>
</a>

<style>
  .site-title {
    align-items: center;
    gap: var(--sl-nav-gap);
    font-size: var(--sl-text-h4);
    font-weight: 600;
    color: var(--sl-color-white);
    text-decoration: none;
    white-space: nowrap;
    min-width: 0;
  }
  span {
    overflow: hidden;
  }
  .mark {
    flex: none;
    height: calc(var(--sl-nav-height) - 2 * var(--sl-nav-pad-y));
    width: auto;
    aspect-ratio: 1;
  }
</style>
