# Build and run the Rust connector for the e2e harness.
# Build context is the tedge-dot/ project root (see docker-compose.yaml).

# Base images come from the AWS ECR Public mirror of the Docker Official
# Images rather than Docker Hub: GitHub-hosted runners share Docker Hub's
# anonymous pull quota, and CI has hit auth.docker.io connection resets
# mid-build. Override BASE_REGISTRY to go back to docker.io/library;
# CI sets it to the GHCR mirror of .github/mirror-images.txt.
ARG BASE_REGISTRY=public.ecr.aws/docker/library
# Accepted (and ignored) so the compose file can pass it to either implementation's
# Dockerfile; the C build (connectors/_shared/Dockerfile.connector-c) selects its module with it.
ARG PROTOCOL=modbus

FROM ${BASE_REGISTRY}/rust:1-bookworm AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,id=tedge-dot-modbus-target,target=/src/impl/rust/target \
    cargo build --manifest-path impl/rust/Cargo.toml --release --no-default-features --features modbus --bin tedge-dot && \
    # cargo build --manifest-path impl/rust/Cargo.toml --release --bin tedge-dot && \
    cp /src/impl/rust/target/release/tedge-dot /usr/local/bin/tedge-dot

FROM ${BASE_REGISTRY}/debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends netcat-openbsd ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/bin/tedge-dot /usr/bin/tedge-dot
COPY connectors/modbus/connector.toml /etc/connector.toml
# Point libraries referenced by connector.toml (contract §3.4), twice over
# because the config references one of each form: at the packaged search-path
# location a shipped package uses (for the reference by name), and next to the
# config itself (for the relative-path reference, which resolves against the
# config's own directory).
COPY connectors/modbus/points.d/ /usr/share/tedge-dot/points.d/
COPY connectors/modbus/points.d/ /etc/points.d/
# Config template of the multi-device stack (docker-compose.multi-device.yaml), rendered by the
# entrypoint when MULTI_DEVICE_COUNT is set.
COPY connectors/modbus/multi-device/ /usr/share/tedge-dot/multi-device/
COPY connectors/modbus/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENV RUST_LOG=info
ENTRYPOINT ["/entrypoint.sh"]
