# Build and run the C connector (impl/c/) for the e2e harness — the C counterpart of
# connectors/<proto>/Dockerfile.connector, so the SAME Robot suites run against both
# implementations. Build context is the repository root; PROTOCOL selects which
# connector module is compiled in and which stack's config/entrypoint is installed.
#
# Base images come from the AWS ECR Public mirror of the Docker Official Images (see the
# Rust Dockerfiles for why); override BASE_REGISTRY to go back to docker.io/library.
ARG BASE_REGISTRY=public.ecr.aws/docker/library

FROM ${BASE_REGISTRY}/debian:bookworm AS build
ARG PROTOCOL=modbus
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        build-essential cmake ninja-build pkg-config git ca-certificates python3 perl file \
        libmodbus-dev libmosquitto-dev libcjson-dev \
    && rm -rf /var/lib/apt/lists/*
WORKDIR /src
COPY impl/c /src/impl/c
COPY impl/rust/crates/sdk/conformance /src/impl/rust/crates/sdk/conformance
# Only the selected module is compiled in (open62541 is fetched and built from source for
# opcua, which is the slow part; the other protocols skip it entirely).
RUN --mount=type=cache,id=tedge-dot-c-build-${PROTOCOL},target=/src/build \
    on() { [ "$1" = "${PROTOCOL}" ] && echo ON || echo OFF; } \
    && cmake -S impl/c -B build -G Ninja -DCMAKE_BUILD_TYPE=Release \
        -DTDOT_MODBUS=$(on modbus) -DTDOT_OPCUA=$(on opcua) -DTDOT_PROFIBUS=$(on profibus) \
        -DTDOT_CANBUS=$(on canbus) -DTDOT_CANOPEN=$(on canopen) -DTDOT_SNMP=$(on snmp) \
    && cmake --build build --target tedge-dot \
    && cp build/tedge-dot /usr/local/bin/tedge-dot

FROM ${BASE_REGISTRY}/debian:bookworm-slim
ARG PROTOCOL=modbus
RUN apt-get update \
    && apt-get install -y --no-install-recommends \
        netcat-openbsd ca-certificates iproute2 kmod libmodbus5 libmosquitto1 libcjson1 \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/bin/tedge-dot /usr/bin/tedge-dot
# Same config and entrypoint as the Rust image of this stack (the entrypoint's
# `tedge-dot /etc/connector.toml` form is accepted by both binaries).
COPY connectors/${PROTOCOL} /opt/connector
RUN cp /opt/connector/connector.toml /etc/connector.toml \
    && cp /opt/connector/entrypoint.sh /entrypoint.sh && chmod +x /entrypoint.sh \
    # Point libraries the stack's config references (contract §3.4); only some stacks
    # have them. Installed twice over, matching the Rust image: at the packaged
    # search-path location (for a reference by name) and next to the config itself
    # (for a relative-path reference, which resolves against the config's directory).
    && if [ -d /opt/connector/points.d ]; then mkdir -p /usr/share/tedge-dot \
        && cp -r /opt/connector/points.d /usr/share/tedge-dot/points.d \
        && cp -r /opt/connector/points.d /etc/points.d; fi \
    # Config template of a multi-device stack, rendered by its entrypoint (modbus only).
    && if [ -d /opt/connector/multi-device ]; then mkdir -p /usr/share/tedge-dot \
        && cp -r /opt/connector/multi-device /usr/share/tedge-dot/multi-device; fi \
    && if [ -f /opt/connector/sim/test.dbc ]; then cp /opt/connector/sim/test.dbc /test.dbc; fi \
    # Secrets the stack's config reads with *_password_file (SNMPv3), installed the same way
    # as in the Rust image and kept unreadable to anyone but the connector.
    && if [ -d /opt/connector/secrets ]; then mkdir -p /etc/tedge-dot && cp -r /opt/connector/secrets /etc/tedge-dot/secrets && chmod 0700 /etc/tedge-dot/secrets && chmod 0600 /etc/tedge-dot/secrets/*; fi \
    && rm -rf /opt/connector
ENTRYPOINT ["/entrypoint.sh"]
