# Build and run the Rust CAN bus connector for the e2e harness.
# Build context is the tedge-dot/ project root (see docker-compose.yaml).

# Base images come from the AWS ECR Public mirror of the Docker Official
# Images rather than Docker Hub: GitHub-hosted runners share Docker Hub's
# anonymous pull quota, and CI has hit auth.docker.io connection resets
# mid-build. Override BASE_REGISTRY to go back to docker.io/library;
# CI sets it to the GHCR mirror of .github/mirror-images.txt.
ARG BASE_REGISTRY=public.ecr.aws/docker/library
# Accepted (and ignored) so the compose file can pass it to either implementation's
# Dockerfile; the C build (connectors/_shared/Dockerfile.connector-c) selects its module with it.
ARG PROTOCOL=canbus

FROM ${BASE_REGISTRY}/rust:1-bookworm AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,id=tedge-dot-canbus-target,target=/src/impl/rust/target \
    cargo build --manifest-path impl/rust/Cargo.toml --release --no-default-features --features canbus --bin tedge-dot && \
    cp /src/impl/rust/target/release/tedge-dot /usr/local/bin/tedge-dot

FROM ${BASE_REGISTRY}/debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends netcat-openbsd ca-certificates iproute2 kmod \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/bin/tedge-dot /usr/bin/tedge-dot
COPY connectors/canbus/connector.toml /etc/connector.toml
COPY connectors/canbus/sim/test.dbc /test.dbc
COPY connectors/canbus/entrypoint.sh /entrypoint.sh
RUN chmod +x /entrypoint.sh
ENV RUST_LOG=info
ENTRYPOINT ["/entrypoint.sh"]
