# Build and run the Rust AVEVA PI Web API connector for the e2e harness.
# Build context is the tedge-dot/ project root (see docker-compose.yaml).
# CI overrides BASE_REGISTRY with the GHCR mirror of .github/mirror-images.txt.
ARG BASE_REGISTRY=public.ecr.aws/docker/library
# Accepted (and ignored) so the compose file can pass it to either implementation's
# Dockerfile; the C build (connectors/_shared/Dockerfile.connector-c) selects its module with it.
ARG PROTOCOL=aveva-pi

FROM ${BASE_REGISTRY}/rust:1-bookworm AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,id=tedge-dot-aveva-pi-target,target=/src/impl/rust/target \
    cargo build --manifest-path impl/rust/Cargo.toml --release --no-default-features --features aveva-pi --bin tedge-dot && \
    cp /src/impl/rust/target/release/tedge-dot /usr/local/bin/tedge-dot

FROM ${BASE_REGISTRY}/debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends netcat-openbsd ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/bin/tedge-dot /usr/bin/tedge-dot
COPY connectors/aveva-pi/connector.toml /etc/connector.toml
COPY connectors/aveva-pi/connector-measure.toml /etc/connector-measure.toml
COPY connectors/aveva-pi/entrypoint.sh /entrypoint.sh
# Passwords and tokens connector.toml reads with *_file (connectors/_shared/Dockerfile.connector-c
# installs them at the same path). The delivery cursors live in the packaged state_dir.
COPY connectors/aveva-pi/secrets /etc/tedge-dot/secrets
RUN chmod +x /entrypoint.sh && chmod 0700 /etc/tedge-dot/secrets && chmod 0600 /etc/tedge-dot/secrets/* \
    && mkdir -p /var/lib/tedge-dot/aveva-pi
ENV RUST_LOG=info
ENTRYPOINT ["/entrypoint.sh"]
