# Connector configuration of the OPC UA INTEROP stack (docker-compose.yaml,
# tests/opcua_interop.robot). The servers are the UA-.NETStandard reference stack.
#
# `@NS_<SERVER>@` is substituted by resolve-ns.py with the real index of
# `urn:opcua:testserver:nodes` **on that server**: the reference server's namespace indices are
# documented as typical, not guaranteed, and the connector addresses nodes only by index. Each
# server is asked separately, because the index is the server's to choose.
#
# Every constant point sets `subscribe = false`. The reference server's scalar values never
# change, so an on-change subscription publishes the initial value and then goes quiet for the
# rest of the run -- only TestServer/Dynamic/Counter is pushed.
#
# Most secured devices set `trust_any_server_certificate` because the reference server
# regenerates its certificate on every start, so there is nothing stable to pin.
# The `tofu` device deliberately does NOT, so the quarantine-then-`tedge-dot pki trust` flow is
# exercised against a real server; and `strict` does, so that the test asserting the SERVER
# refuses US is not also gated on our judgement of it.

[connector]
protocol      = "opcua"
service_name  = "tedge-dot"
poll_interval = "1s"
log_level     = "info"
operation_timeout = "10s"

[mqtt]
host = "broker"
port = 1883

[connection]
application_uri   = "urn:tedge-dot"
connect_timeout_s = 15

# ---------------------------------------------------------------- ref-all: policies & modes

# No message security at all.
[[device]]
name             = "plain"
protocol_address = { endpoint = "opc.tcp://ref-all:4840/UA/TestServer", security_policy = "None", security_mode = "none" }
  [[device.point]]
  id = "double"
  datatype = "float64"
  subscribe = false
  address = { node_id = "ns=@NS_REF_ALL@;s=TestServer/DataTypes/Scalar/DoubleValue" }
  [[device.point]]
  id = "bool"
  datatype = "bool"
  subscribe = false
  address = { node_id = "ns=@NS_REF_ALL@;s=TestServer/DataTypes/Scalar/BooleanValue" }
  [[device.point]]
  id = "int32"
  datatype = "int32"
  subscribe = false
  address = { node_id = "ns=@NS_REF_ALL@;s=TestServer/DataTypes/Scalar/Int32Value" }
  [[device.point]]
  id = "string"
  datatype = "string"
  subscribe = false
  address = { node_id = "ns=@NS_REF_ALL@;s=TestServer/DataTypes/Scalar/StringValue" }

# Signed only: the message is authenticated but not encrypted.
[[device]]
name             = "b256-sign"
protocol_address = { endpoint = "opc.tcp://ref-all:4840/UA/TestServer", security_policy = "Basic256Sha256", security_mode = "sign", trust_any_server_certificate = true }
  [[device.point]]
  id = "double"
  datatype = "float64"
  subscribe = false
  address = { node_id = "ns=@NS_REF_ALL@;s=TestServer/DataTypes/Scalar/DoubleValue" }

[[device]]
name             = "b256-seal"
protocol_address = { endpoint = "opc.tcp://ref-all:4840/UA/TestServer", security_policy = "Basic256Sha256", security_mode = "sign_and_encrypt", trust_any_server_certificate = true }
  [[device.point]]
  id = "double"
  datatype = "float64"
  subscribe = false
  address = { node_id = "ns=@NS_REF_ALL@;s=TestServer/DataTypes/Scalar/DoubleValue" }

# Until now this policy was only ever exercised negatively, to produce a "no matching
# endpoint" reason. Here it has to actually work.
[[device]]
name             = "aes128"
protocol_address = { endpoint = "opc.tcp://ref-all:4840/UA/TestServer", security_policy = "Aes128_Sha256_RsaOaep", security_mode = "sign_and_encrypt", trust_any_server_certificate = true }
  [[device.point]]
  id = "double"
  datatype = "float64"
  subscribe = false
  address = { node_id = "ns=@NS_REF_ALL@;s=TestServer/DataTypes/Scalar/DoubleValue" }

[[device]]
name             = "aes256"
protocol_address = { endpoint = "opc.tcp://ref-all:4840/UA/TestServer", security_policy = "Aes256_Sha256_RsaPss", security_mode = "sign_and_encrypt", trust_any_server_certificate = true }
  [[device.point]]
  id = "double"
  datatype = "float64"
  subscribe = false
  address = { node_id = "ns=@NS_REF_ALL@;s=TestServer/DataTypes/Scalar/DoubleValue" }

# Deprecated, and until now only covered by configuration-validation unit tests.
[[device]]
name             = "legacy-b256"
protocol_address = { endpoint = "opc.tcp://ref-all:4840/UA/TestServer", security_policy = "Basic256", security_mode = "sign_and_encrypt", trust_any_server_certificate = true, allow_deprecated_security = true }
  [[device.point]]
  id = "double"
  datatype = "float64"
  subscribe = false
  address = { node_id = "ns=@NS_REF_ALL@;s=TestServer/DataTypes/Scalar/DoubleValue" }

[[device]]
name             = "legacy-b128"
protocol_address = { endpoint = "opc.tcp://ref-all:4840/UA/TestServer", security_policy = "Basic128Rsa15", security_mode = "sign_and_encrypt", trust_any_server_certificate = true, allow_deprecated_security = true }
  [[device.point]]
  id = "double"
  datatype = "float64"
  subscribe = false
  address = { node_id = "ns=@NS_REF_ALL@;s=TestServer/DataTypes/Scalar/DoubleValue" }

# ------------------------------------------------------------------------ ref-all: identity

# The reference server's shipped user database (config/users.json).
[[device]]
name             = "user"
protocol_address = { endpoint = "opc.tcp://ref-all:4840/UA/TestServer", security_policy = "Basic256Sha256", security_mode = "sign_and_encrypt", trust_any_server_certificate = true, user = "operator", password_file = "/opt/interop/operator-password" }
  [[device.point]]
  id = "double"
  datatype = "float64"
  subscribe = false
  address = { node_id = "ns=@NS_REF_ALL@;s=TestServer/DataTypes/Scalar/DoubleValue" }

[[device]]
name             = "baduser"
protocol_address = { endpoint = "opc.tcp://ref-all:4840/UA/TestServer", security_policy = "Basic256Sha256", security_mode = "sign_and_encrypt", trust_any_server_certificate = true, user = "operator", password = "not-the-password" }
  [[device.point]]
  id = "double"
  datatype = "float64"
  subscribe = false
  address = { node_id = "ns=@NS_REF_ALL@;s=TestServer/DataTypes/Scalar/DoubleValue" }

# ------------------------------------------------------------------- ref-all: push delivery

[[device]]
name             = "dynamic"
protocol_address = { endpoint = "opc.tcp://ref-all:4840/UA/TestServer", security_policy = "Basic256Sha256", security_mode = "sign_and_encrypt", trust_any_server_certificate = true }
  [[device.point]]
  id = "counter"
  datatype = "uint32"
  subscribe = true
  address = { node_id = "ns=@NS_REF_ALL@;s=TestServer/Dynamic/Counter" }

# ----------------------------------------------------------------------------- trust flows

# No opt-out: first contact must quarantine the server certificate, and the suite then trusts
# it by thumbprint with `tedge-dot pki trust`.
[[device]]
name             = "tofu"
protocol_address = { endpoint = "opc.tcp://ref-all:4840/UA/TestServer", security_policy = "Basic256Sha256", security_mode = "sign_and_encrypt" }
  [[device.point]]
  id = "double"
  datatype = "float64"
  subscribe = false
  address = { node_id = "ns=@NS_REF_ALL@;s=TestServer/DataTypes/Scalar/DoubleValue" }

# The server does not auto-accept our application certificate. We trust it (trust_any), so the
# only thing that can fail is its judgement of us.
[[device]]
name             = "strict"
protocol_address = { endpoint = "opc.tcp://ref-strict:4840/UA/TestServer", security_policy = "Basic256Sha256", security_mode = "sign_and_encrypt", trust_any_server_certificate = true }
  [[device.point]]
  id = "double"
  datatype = "float64"
  subscribe = false
  address = { node_id = "ns=@NS_REF_STRICT@;s=TestServer/DataTypes/Scalar/DoubleValue" }

# --------------------------------------------------------------------------- other servers

# Policies neither implementation has: must refuse cleanly and list what was offered.
[[device]]
name             = "ecc"
protocol_address = { endpoint = "opc.tcp://ref-ecc:4840/UA/TestServer", security_policy = "Basic256Sha256", security_mode = "sign_and_encrypt", trust_any_server_certificate = true }
  [[device.point]]
  id = "double"
  datatype = "float64"
  subscribe = false
  address = { node_id = "ns=@NS_REF_ALL@;s=TestServer/DataTypes/Scalar/DoubleValue" }

# ref-discovery keeps the 1024-bit certificate UA-.NETStandard generates for itself, which
# Basic256Sha256 forbids: a conformant client must refuse it however the trust store is set up,
# and must say that the key is too short rather than advise trusting it.
[[device]]
name             = "weakcert"
protocol_address = { endpoint = "opc.tcp://ref-discovery:4840", security_policy = "Basic256Sha256", security_mode = "sign_and_encrypt", trust_any_server_certificate = true }
  [[device.point]]
  id = "double"
  datatype = "float64"
  subscribe = false
  address = { node_id = "ns=@NS_REF_DISCOVERY@;s=TestServer/DataTypes/Scalar/DoubleValue" }

# A 30-second secure channel token: the session has to renew to survive the test.
[[device]]
name             = "token"
protocol_address = { endpoint = "opc.tcp://ref-token:4840/UA/TestServer", security_policy = "Basic256Sha256", security_mode = "sign_and_encrypt", trust_any_server_certificate = true }
  [[device.point]]
  id = "counter"
  datatype = "uint32"
  subscribe = false
  address = { node_id = "ns=@NS_REF_TOKEN@;s=TestServer/Dynamic/Counter" }

# An endpoint URL with no resource path.
[[device]]
name             = "discovery"
protocol_address = { endpoint = "opc.tcp://ref-discovery:4840", security_policy = "None", security_mode = "none" }
  [[device.point]]
  id = "double"
  datatype = "float64"
  subscribe = false
  address = { node_id = "ns=@NS_REF_DISCOVERY@;s=TestServer/DataTypes/Scalar/DoubleValue" }
