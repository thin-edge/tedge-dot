# Build and run the Rust SNMP trap connector for the e2e harness.
# Build context is the tedge-dot/ project root (see docker-compose.yaml).

# Base images come from the AWS ECR Public mirror of the Docker Official Images (see
# connectors/modbus/Dockerfile.connector); override BASE_REGISTRY to go back to docker.io.
ARG BASE_REGISTRY=public.ecr.aws/docker/library
# Accepted (and ignored) so the compose file can pass it to either implementation's
# Dockerfile; the C build (connectors/_shared/Dockerfile.connector-c) selects its module with it.
ARG PROTOCOL=snmp

FROM ${BASE_REGISTRY}/rust:1-bookworm AS build
WORKDIR /src
COPY . .
RUN --mount=type=cache,target=/usr/local/cargo/registry \
    --mount=type=cache,target=/usr/local/cargo/git \
    --mount=type=cache,id=tedge-dot-snmp-target,target=/src/impl/rust/target \
    cargo build --manifest-path impl/rust/Cargo.toml --release --no-default-features --features snmp --bin tedge-dot && \
    cp /src/impl/rust/target/release/tedge-dot /usr/local/bin/tedge-dot

FROM ${BASE_REGISTRY}/debian:bookworm-slim
RUN apt-get update \
    && apt-get install -y --no-install-recommends netcat-openbsd ca-certificates \
    && rm -rf /var/lib/apt/lists/*
COPY --from=build /usr/local/bin/tedge-dot /usr/bin/tedge-dot
COPY connectors/snmp/connector.toml /etc/connector.toml
COPY connectors/snmp/entrypoint.sh /entrypoint.sh
# SNMPv3 passwords connector.toml reads with `*_password_file` (connectors/_shared/Dockerfile.connector-c
# installs them at the same path).
COPY connectors/snmp/secrets /etc/tedge-dot/secrets
RUN chmod +x /entrypoint.sh && chmod 0700 /etc/tedge-dot/secrets && chmod 0600 /etc/tedge-dot/secrets/*
ENV RUST_LOG=info
ENTRYPOINT ["/entrypoint.sh"]
