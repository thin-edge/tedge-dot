#!/bin/sh
# Send one SNMP notification to $TRAP_TARGET (default connector:162) with net-snmp.
#
#   send-trap linkdown <ifIndex>        v2c linkDown   (ifIndex, ifAdminStatus, ifOperStatus)
#   send-trap linkdown-addressed <i>    v2c linkDown that also carries snmpTrapAddress.0 = this
#                                       container's own IPv4 address (as equipment behind a relay
#                                       does); the only kind a stock snmptrapd forwarder passes on
#                                       with that varbind, since it adds none itself
#   send-trap linkup <ifIndex>          v2c linkUp     (ifIndex)
#   send-trap coldstart                 v1  coldStart  (generic-trap 0, agent-addr 10.0.0.9)
#   send-trap overheat <text> <tenths>  v2c enterprise 1.3.6.1.4.1.99999.0.1 (text, temperature, status bytes)
#   send-trap inform <text>             v2c InformRequest 1.3.6.1.4.1.99999.0.2; exits non-zero
#                                       unless the receiver acknowledges it
#   send-trap v3-linkdown <ifIndex>     v3 authPriv linkDown, sent from engine $TRAP_ENGINE_ID
#   send-trap v3-inform <text>          v3 authPriv InformRequest 1.3.6.1.4.1.99999.0.2 (discovers the
#                                       receiver's engine first); exits non-zero unless acknowledged
#
# COMMUNITY (default public) sets the v1/v2c community string.
#
# v3 notifications use SHA (SHA-1) authentication and AES (AES-128) privacy with
#   V3_USER       (default trap-user)
#   V3_AUTH_PASS  (default trap-auth-pass-1)
#   V3_PRIV_PASS  (default trap-priv-pass-1)
#   TRAP_ENGINE_ID  this sender's authoritative engine ID for v3 traps (default
#                   80001f8880e2e000000000a001); an inform uses the receiver's engine instead.
# connectors/snmp/connector.toml configures the same user, passwords and engine ID for the device
# these notifications come from; the suite overrides a password to send one the device must drop.
set -eu

target=${TRAP_TARGET:-connector:162}
community=${COMMUNITY:-public}
ent=1.3.6.1.4.1.99999
if_mib=1.3.6.1.2.1.2.2.1

v3_user=${V3_USER:-trap-user}
v3_auth=${V3_AUTH_PASS:-trap-auth-pass-1}
v3_priv=${V3_PRIV_PASS:-trap-priv-pass-1}
engine_id=${TRAP_ENGINE_ID:-80001f8880e2e000000000a001}

kind=${1:?usage: send-trap <linkdown|linkup|coldstart|overheat|inform|v3-linkdown|v3-inform> [args]}
shift

case "$kind" in
linkdown)
    i=${1:-1}
    exec snmptrap -m '' -v 2c -c "$community" "$target" '' 1.3.6.1.6.3.1.1.5.3 \
        "$if_mib.1.$i" i "$i" "$if_mib.7.$i" i 1 "$if_mib.8.$i" i 2
    ;;
linkdown-addressed)
    i=${1:-1}
    self=$(getent ahostsv4 "$(cat /etc/hostname)" | head -n 1 | cut -d ' ' -f 1)
    exec snmptrap -m '' -v 2c -c "$community" "$target" '' 1.3.6.1.6.3.1.1.5.3 \
        "$if_mib.1.$i" i "$i" 1.3.6.1.6.3.18.1.3.0 a "$self"
    ;;
linkup)
    i=${1:-1}
    exec snmptrap -m '' -v 2c -c "$community" "$target" '' 1.3.6.1.6.3.1.1.5.4 "$if_mib.1.$i" i "$i"
    ;;
coldstart)
    exec snmptrap -m '' -v 1 -c "$community" "$target" "$ent" 10.0.0.9 0 0 ''
    ;;
overheat)
    exec snmptrap -m '' -v 2c -c "$community" "$target" '' "$ent.0.1" \
        "$ent.2.1" s "${1:-Pump overheated}" "$ent.2.2" i "${2:-853}" "$ent.2.3" x "0102FF"
    ;;
inform)
    exec snmpinform -m '' -v 2c -c "$community" -r 1 -t 3 "$target" '' "$ent.0.2" \
        "$ent.2.9" s "${1:-inform}"
    ;;
v3-linkdown)
    i=${1:-1}
    exec snmptrap -m '' -v 3 -e "$engine_id" -u "$v3_user" -l authPriv \
        -a SHA -A "$v3_auth" -x AES -X "$v3_priv" \
        "$target" '' 1.3.6.1.6.3.1.1.5.3 \
        "$if_mib.1.$i" i "$i" "$if_mib.7.$i" i 1 "$if_mib.8.$i" i 2
    ;;
v3-linkdown-noauth)
    # The same user and engine, but noAuthNoPriv: no authentication, no privacy. A device
    # configured authNoPriv or authPriv must refuse it -- and, critically, must refuse it
    # WITHOUT learning anything from it, since an unauthenticated message proves nothing about
    # who sent it (spec §4.1 step 3).
    i=${1:-1}
    exec snmptrap -m '' -v 3 -e "$engine_id" -u "$v3_user" -l noAuthNoPriv \
        "$target" '' 1.3.6.1.6.3.1.1.5.3 \
        "$if_mib.1.$i" i "$i" "$if_mib.7.$i" i 1 "$if_mib.8.$i" i 2
    ;;
v3-inform)
    exec snmpinform -m '' -v 3 -u "$v3_user" -l authPriv \
        -a SHA -A "$v3_auth" -x AES -X "$v3_priv" -r 1 -t 3 \
        "$target" '' "$ent.0.2" "$ent.2.9" s "${1:-inform}"
    ;;
*)
    echo "unknown notification kind: $kind" >&2
    exit 2
    ;;
esac
