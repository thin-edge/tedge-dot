# Cumulocity tenant for the cloud e2e suites (`just test-cloud <proto>`, `just test-cloud-c <proto>`).
# Copy to .env (git-ignored) and fill in; `just` and the Robot libraries read it.
# The suites register a device named TST_<random>, and delete it and its user at teardown.
C8Y_BASEURL=https://example.cumulocity.com
C8Y_USER=
C8Y_PASSWORD=
# Optional when C8Y_USER is written as <tenant>/<user>.
C8Y_TENANT=
