# c8y_ModbusConfiguration -> generic `ot_set_config` command (poll interval).
#
# The legacy operation carried `transmitRate`/`pollingRate`. `pollingRate` maps to
# `connector.poll_interval`. `transmitRate` is not mapped; its equivalent is the reporting policy
# `[connector] report = { min_interval = "..." }` (doc/reducing-data-volume.md). The SDK runtime
# applies the patch, persists the config, and live-reloads without a restart.
[exec]
  topic = "c8y/devicecontrol/notifications"
  on_fragment = "c8y_ModbusConfiguration"

[exec.workflow]
operation = "ot_set_config"
input.target = "connector"
input.config.poll_interval = "${.payload.c8y_ModbusConfiguration.pollingRate}"
